# Public application origin used for auth callbacks and deployment metadata.
# Development may use localhost. Production MUST set an https origin root with
# no path/query/hash, for example https://english.example.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser/server-session connection. The publishable/anon key is safe
# to expose only because database authorization is enforced with RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC and never expose it to the browser.
# It bypasses RLS and is reserved for authoritative server-side learning-state writes.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI variables will be added when their implementation task begins.
