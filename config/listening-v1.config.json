  "accent_progression": {
    "principle": "Do not penalize non-native accent identity. Build receptive flexibility gradually and use only reviewed, intelligible audio.",
    "A1": "one clear familiar accent per asset; rotate across sessions",
    "A2": "introduce a second familiar accent across the week",
    "B1": "regular exposure to North American/British and selected Australian/international-clear speech",
    "B2": "systematic variation including North American, British, Australian and New Zealand for IELTS readiness"
