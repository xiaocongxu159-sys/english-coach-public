  "mode_policies": {
    "guided_learning": {
      "transcript_unlock": "after_first_attempt_or_later",
      "segment_replay_allowed": true,
      "speed_control_allowed": true,
      "state_changing_evidence_default": false
    },
    "scored_practice": {
      "transcript_unlock": "after_scored_attempt",
      "segment_replay_allowed": false,
      "speed_control_allowed": false,
      "state_changing_evidence_default": true
