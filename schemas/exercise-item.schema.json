{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-coach.local/schemas/exercise-item.schema.json",
  "title":"English Coach Exercise Item",
  "type":"object",
  "additionalProperties":false,
  "required":["id","version","status","template_id","level","task_type","target_node_ids","evidence_type","content","answer_spec","provenance","validation","state_effect_policy"],
  "properties":{
    "id":{"type":"string","pattern":"^EI-(A1|A2|B1|B2)-[A-Z0-9-]+-[0-9]{3}$"},
    "version":{"type":"integer","minimum":1},
    "status":{"enum":["draft","validated","active","rejected","deprecated"]},
    "template_id":{"type":"string","pattern":"^ET-(A1|A2|B1|B2)-[A-Z0-9-]+-[0-9]{2}$"},
    "level":{"enum":["A1","A2","B1","B2"]},
    "task_type":{"enum":["multiple_choice_single","multiple_choice_multi","true_false","fill_blank","short_answer","ordering","matching","error_correction","sentence_transformation","controlled_production","free_written","free_spoken","listening_completion","listening_choice","reading_choice","reading_completion","pronunciation_production","communication_roleplay"]},
    "target_node_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(GR|VX|LS|SP|RD|WR|PR|CF)-(A1|A2|B1|B2)-[A-Z0-9-]+-[0-9]{2}$"}},
    "support_node_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^(GR|VX|LS|SP|RD|WR|PR|CF)-(A1|A2|B1|B2)-[A-Z0-9-]+-[0-9]{2}$"}},
    "evidence_type":{"enum":["recognition","controlled_production","free_written_production","free_spoken_production","spontaneous_reuse","listening_comprehension","reading_comprehension","pronunciation_intelligibility","communication_repair"]},
    "content":{
      "type":"object","additionalProperties":false,"required":["prompt","stimulus","options"],
      "properties":{
        "prompt":{"type":"string","minLength":1,"maxLength":1500},
        "stimulus":{"type":["string","null"],"maxLength":5000},
        "asset_ref":{"type":["string","null"],"maxLength":160},
        "options":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["id","text"],"properties":{"id":{"type":"string","minLength":1,"maxLength":20},"text":{"type":"string","minLength":1,"maxLength":800}}}}
      }
    },
    "answer_spec":{
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["kind","accepted_answers","correct_option_ids","normalization"],"properties":{"kind":{"const":"deterministic"},"accepted_answers":{"type":"array","items":{"type":"string","maxLength":1000}},"correct_option_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","maxLength":20}},"normalization":{"type":"array","uniqueItems":true,"items":{"enum":["trim","casefold","collapse_whitespace","ignore_terminal_punctuation","numeric_equivalence"]}},"word_limit":{"type":["integer","null"],"minimum":1,"maximum":20}}},
        {"type":"object","additionalProperties":false,"required":["kind","rubric_id","dimensions","minimum_evaluator_confidence"],"properties":{"kind":{"const":"rubric"},"rubric_id":{"type":"string","minLength":3,"maxLength":120},"dimensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":80}},"minimum_evaluator_confidence":{"enum":["medium","high"]}}},
        {"type":"object","additionalProperties":false,"required":["kind","deterministic_component","rubric_id","dimensions","minimum_evaluator_confidence"],"properties":{"kind":{"const":"hybrid"},"deterministic_component":{"type":"string","minLength":1,"maxLength":500},"rubric_id":{"type":"string","minLength":3,"maxLength":120},"dimensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":80}},"minimum_evaluator_confidence":{"enum":["medium","high"]}}}
      ]
    },
    "provenance":{
      "type":"object","additionalProperties":false,"required":["content_class","origin","template_version","generator_ref"],
      "properties":{
        "content_class":{"enum":["reviewed_core","validated_variant","unvalidated_variant","exploratory"]},
        "origin":{"enum":["human","ai_assisted","ai_generated","licensed","open_license"]},
        "template_version":{"type":"integer","minimum":1},
        "generator_ref":{"type":["string","null"],"maxLength":200},
        "seed_or_variant_key":{"type":["string","null"],"maxLength":120}
      }
    },
    "validation":{
      "type":"object","additionalProperties":false,"required":["schema_pass","scope_pass","answer_pass","ambiguity_pass","level_pass","independent_qa_pass"],
      "properties":{"schema_pass":{"type":"boolean"},"scope_pass":{"type":"boolean"},"answer_pass":{"type":"boolean"},"ambiguity_pass":{"type":"boolean"},"level_pass":{"type":"boolean"},"independent_qa_pass":{"type":"boolean"},"validator_notes":{"type":["string","null"],"maxLength":1000}}
    },
    "state_effect_policy":{
      "type":"object","additionalProperties":false,"required":["may_change_mastery","may_update_review"],
      "properties":{"may_change_mastery":{"type":"boolean"},"may_update_review":{"type":"boolean"}}
    }
  }
}
