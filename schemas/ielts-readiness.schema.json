{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-coach.local/schemas/ielts-readiness.schema.json",
  "title":"English Coach IELTS Readiness Profile",
  "type":"object",
  "additionalProperties":false,
  "required":["learner_id","exam_variant","target","stage","components","evidence_window_days","estimated_not_official","updated_at"],
  "properties":{
    "learner_id":{"type":"string","minLength":1,"maxLength":128},
    "exam_variant":{"enum":["academic","general_training","undecided"]},
    "target":{
      "type":"object","additionalProperties":false,"required":["overall_band","minimum_component_band"],
      "properties":{
        "overall_band":{"type":["number","null"],"minimum":0,"maximum":9,"multipleOf":0.5},
        "minimum_component_band":{"type":["number","null"],"minimum":0,"maximum":9,"multipleOf":0.5}
      }
    },
    "stage":{"enum":["general_foundation","format_familiarization","guided_mini_tasks","timed_component_practice","full_mock_diagnostics","target_readiness"]},
    "components":{
      "type":"object","additionalProperties":false,"required":["listening","reading","writing","speaking"],
      "properties":{
        "listening":{"$ref":"#/$defs/component"},
        "reading":{"$ref":"#/$defs/component"},
        "writing":{"$ref":"#/$defs/component"},
        "speaking":{"$ref":"#/$defs/component"}
      }
    },
    "evidence_window_days":{"type":"integer","minimum":1,"maximum":180},
    "estimated_overall_band":{"type":["number","null"],"minimum":0,"maximum":9,"multipleOf":0.5},
    "estimated_not_official":{"const":true},
    "warnings":{"type":"array","items":{"type":"string","maxLength":300}},
    "updated_at":{"type":"string","format":"date-time"}
  },
  "$defs":{
    "component":{
      "type":"object","additionalProperties":false,
      "required":["estimated_band_low","estimated_band_high","confidence","validated_checkpoint_count","full_component_count","last_checkpoint_at"],
      "properties":{
        "estimated_band_low":{"type":["number","null"],"minimum":0,"maximum":9,"multipleOf":0.5},
        "estimated_band_high":{"type":["number","null"],"minimum":0,"maximum":9,"multipleOf":0.5},
        "confidence":{"enum":["none","low","medium","high"]},
        "validated_checkpoint_count":{"type":"integer","minimum":0},
        "full_component_count":{"type":"integer","minimum":0},
        "last_checkpoint_at":{"type":["string","null"],"format":"date-time"}
      }
    }
  }
}
